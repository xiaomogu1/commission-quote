{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/commission-quotes",
    "headers": { "api-key": { "equalTo": "local-dev-only-key" } },
    "bodyPatterns": [ { "matchesJsonPath": "$[?(@.loanAmount == 4040.4)]" } ]
  },
  "response": {
    "status": 500,
    "headers": { "Content-Type": "application/problem+json" },
    "jsonBody": { "title": "Internal Server Error", "status": 500, "detail": "Vendor is temporarily unable to process the request" }
  }
}
