{
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/v1/commission-quotes",
    "headers": { "api-key": { "equalTo": "local-dev-only-key" } }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"quoteId\": \"Q-STUB-{{randomValue type='UUID'}}\", \"commissionRate\": 0.006, \"totalCommission\": {{math (jsonPath request.body '$.loanAmount') '*' 0.006}}}"
  }
}
