# Copy to .env for local runs:  cp .env.example .env
# .env is git-ignored. Never commit a real key.
# In stg/prd the key is NOT set here: the BFF reads it from AWS Secrets Manager.

# Shared secret: the vendor mock accepts it, the BFF sends it. The browser never sees it.
VENDOR_API_KEY=local-dev-only-key

# Vendor mock behaviour (simulates an unreliable third party)
VENDOR_FAILURE_RATE=0.2
VENDOR_MIN_LATENCY_MS=100
VENDOR_MAX_LATENCY_MS=800
